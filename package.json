{
  "name": "family-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ניהול כספים לעסק ולמשק בית - עברית, RTL, Mobile-First, Firebase",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project demo-family-finance \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
