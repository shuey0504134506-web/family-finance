rules_version = '2';

// כללי האבטחה של האפליקציה.
//
// עיקרון מרכזי: כל הנתונים של משתמש נמצאים תחת users/{uid}/...
// ורק המשתמש עצמו (request.auth.uid == uid) יכול לקרוא או לכתוב אותם.
// אין כתיבה או קריאה לשום נתיב אחר (ברירת מחדל: חסום).
//
// חשוב: אין כאן match עם {document=**} מתחת ל-users/{uid}. כלל כזה היה עוקף
// את בדיקות התקינות שבכל אוסף, כי ב-Firestore כללים מתחברים ב-OR.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- פונקציות עזר ----------

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- אישור חשבונות ----------
    // approvals/{uid} = {status: 'pending' | 'approved' | 'blocked'}.
    // המשתמש יכול רק ליצור בקשה (pending) לעצמו. את האישור והחסימה כותבות רק פונקציות השרת של המנהל.
    // חשבון בלי רשומה, ממתין או חסום: אין קריאה של נתונים. ממתין: מותרת כתיבה של רשומות ההרשמה בלבד.

    function approvalPath(uid) {
      return /databases/$(database)/documents/approvals/$(uid);
    }

    // דרישת תשלום: approvals/{uid}.payment = {dueAt (אלפיות שנייה), ...}. אחרי המועד, אין גישה לנתונים
    // עד שהמנהל מסיר או מאריך את הדרישה (נכתב בשרת בלבד).
    function paymentDue(a) {
      return a.keys().hasAny(['payment']) && a.payment.dueAt <= request.time.toMillis();
    }

    function isReader(uid) {
      // בלי רשומה, get מחזיר ריק והבדיקה נכשלת: סגור כברירת מחדל
      return isOwner(uid)
             && get(approvalPath(uid)).data.status == 'approved'
             && !paymentDue(get(approvalPath(uid)).data);
    }

    function isWriter(uid) {
      return isOwner(uid)
             && get(approvalPath(uid)).data.status in ['approved', 'pending']
             && !paymentDue(get(approvalPath(uid)).data);
    }

    // ספירת פתיחות האפליקציה ליום: usage/{uid}.days = {'YYYY-MM-DD': מספר}. נקרא בשרת בלבד, לסטטיסטיקה כללית.
    function validUsage(data) {
      return data.keys().hasOnly(['days', 'updatedAt'])
             && data.days is map
             && data.days.size() <= 800
             && data.updatedAt is int;
    }

    match /usage/{uid} {
      allow create, update: if isReader(uid) && validUsage(request.resource.data);
      allow read, delete: if false;
    }

    // הודעות ממשתמש למנהל: messages/{id} = {uid, text, createdAt}. המשתמש יוצר וקורא את שלו בלבד.
    // המנהל קורא ועונה דרך פונקציות השרת (התשובה נכתבת שם: reply, repliedAt). חסום לא יכול לשלוח.
    // גם חשבון שננעל לתשלום או ממתין לאישור יכול לפנות למנהל.
    match /messages/{messageId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && isNonEmptyString(request.resource.data.text, 2000)
                    && request.resource.data.createdAt is int
                    && get(approvalPath(request.auth.uid)).data.status in ['approved', 'pending'];
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /approvals/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['status', 'createdAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // מזהה עסק אופציונלי. חסר = העסק הראשון (נתונים שנשמרו לפני שנוספה תמיכה בכמה עסקים).
    function validOptionalBusinessId(data) {
      return !data.keys().hasAny(['businessId'])
             || isNonEmptyString(data.businessId, 100);
    }

    // ---------- נתוני פרופיל: users/{uid} ----------

    function validUser(data) {
      return data.keys().hasOnly([
               'firstName', 'lastName', 'email', 'businessName',
               'accountMode', 'createdAt', 'updatedAt'
             ])
             && data.keys().hasAll([
               'firstName', 'lastName', 'email', 'businessName',
               'accountMode', 'createdAt', 'updatedAt'
             ])
             && isNonEmptyString(data.firstName, 60)
             && isNonEmptyString(data.lastName, 60)
             && isShortString(data.email, 254)
             && isShortString(data.businessName, 120)
             && data.accountMode in ['both', 'business', 'household']
             && data.createdAt is int
             && data.updatedAt is int;
    }

    // ---------- חובות: users/{uid}/debts/{debtId} ----------

    function validDebt(data, debtId) {
      return data.keys().hasOnly([
               'id', 'scope', 'businessId', 'direction', 'name', 'amountAgorot', 'currency',
               'category', 'paymentMethod', 'paymentLabel', 'date', 'dueDate', 'note',
               'payments', 'createdAt', 'updatedAt'
             ])
             && data.keys().hasAll([
               'id', 'scope', 'direction', 'name', 'amountAgorot', 'category', 'paymentMethod',
               'date', 'note', 'payments', 'createdAt', 'updatedAt'
             ])
             && data.id == debtId
             && data.scope in ['business', 'household']
             && validOptionalBusinessId(data)
             && data.direction in ['owe', 'owed']
             && isNonEmptyString(data.name, 80)
             && data.amountAgorot is int
             && data.amountAgorot > 0
             && data.amountAgorot <= 100000000000
             && (!data.keys().hasAny(['currency']) || data.currency in ['ILS', 'USD', 'EUR', 'GBP'])
             && isNonEmptyString(data.category, 40)
             && data.paymentMethod in ['cash', 'credit', 'direct', 'check', 'transfer', 'other']
             && ((data.paymentMethod == 'other') == data.keys().hasAny(['paymentLabel']))
             && (!data.keys().hasAny(['paymentLabel']) || isNonEmptyString(data.paymentLabel, 30))
             && data.date is string
             && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
             && (!data.keys().hasAny(['dueDate'])
                 || (data.dueDate is string
                     && data.dueDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
             && isShortString(data.note, 1000)
             && data.payments is list
             && data.payments.size() <= 500
             && data.createdAt is int
             && data.updatedAt is int;
    }

    // ---------- אמצעי תשלום אישיים: users/{uid}/settings/paymentMethods ----------

    function validPaymentMethods(data) {
      return data.keys().hasOnly(['income', 'expense', 'updatedAt'])
             && data.keys().hasAll(['income', 'expense', 'updatedAt'])
             && data.income is list && data.income.size() <= 12
             && data.expense is list && data.expense.size() <= 12
             && data.updatedAt is int;
    }

    // ---------- קטגוריות חובות שהוסרו: users/{uid}/settings/debtCategories ----------

    function validDebtCategories(data) {
      return data.keys().hasOnly(['hidden', 'updatedAt'])
             && data.keys().hasAll(['hidden', 'updatedAt'])
             && data.hidden is list && data.hidden.size() <= 40
             && data.updatedAt is int;
    }

    // ---------- לוגו עסק: users/{uid}/settings/logo_{businessId} ----------

    function validLogo(data) {
      return data.keys().hasOnly(['data', 'updatedAt'])
             && data.keys().hasAll(['data', 'updatedAt'])
             && data.data is string && data.data.size() <= 120000
             && data.data.matches('^data:image/(png|jpeg|webp);base64,.*')
             && data.updatedAt is int;
    }

    // ---------- הגדרות: users/{uid}/settings/main ----------

    function validSettings(data) {
      return data.keys().hasOnly([
               'titheBps', 'countBusinessTithePayments',
               'businessTransferMode', 'updatedAt', 'currency', 'annualMode'
             ])
             && data.keys().hasAll([
               'titheBps', 'countBusinessTithePayments',
               'businessTransferMode', 'updatedAt'
             ])
             && data.titheBps is int
             && data.titheBps >= 0
             && data.titheBps <= 10000
             && data.countBusinessTithePayments is bool
             && data.businessTransferMode in ['positive-only', 'allow-negative']
             && (!data.keys().hasAny(['currency'])
                 || data.currency in ['ILS', 'USD', 'EUR', 'GBP'])
             && (!data.keys().hasAny(['annualMode'])
                 || data.annualMode in ['calendar', 'from-start'])
             && data.updatedAt is int;
    }

    // ---------- פרופיל עסק / משק בית ----------

    function validProfileDoc(data) {
      return data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
             && data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
             && isShortString(data.name, 120)
             && data.createdAt is int
             && data.updatedAt is int;
    }

    // ---------- עסקים: users/{uid}/businesses/{businessId} ----------

    function validBusiness(data, businessId) {
      return data.keys().hasOnly(['id', 'name', 'sortOrder', 'createdAt', 'updatedAt'])
             && data.keys().hasAll(['id', 'name', 'sortOrder', 'createdAt', 'updatedAt'])
             && data.id == businessId
             && isNonEmptyString(data.name, 60)
             && data.sortOrder is int
             && data.createdAt is int
             && data.updatedAt is int;
    }

    // ---------- קטגוריות ----------

    function validCategory(data, categoryId) {
      return data.keys().hasOnly([
               'id', 'scope', 'type', 'name', 'active',
               'isDefault', 'sortOrder', 'createdAt', 'updatedAt', 'businessId'
             ])
             && data.keys().hasAll([
               'id', 'scope', 'type', 'name', 'active',
               'isDefault', 'sortOrder', 'createdAt', 'updatedAt'
             ])
             && data.id == categoryId
             && data.scope in ['business', 'household']
             && data.type in ['income', 'expense']
             && isNonEmptyString(data.name, 60)
             && data.active is bool
             && data.isDefault is bool
             && data.sortOrder is int
             && data.createdAt is int
             && data.updatedAt is int
             && validOptionalBusinessId(data);
    }

    // ---------- תקציב: users/{uid}/budgets/{categoryId} ----------
    // תקציב קבוע: מזהה המסמך הוא מזהה הקטגוריה.
    // תקציב לחודש או לשנה: יש שדה period ('YYYY-MM' או 'YYYY') ומזהה המסמך הוא categoryId@period.
    // לכן לכל קטגוריה יש תקציב אחד לכל היותר בכל תקופה.

    function validBudgetPeriod(data, budgetId) {
      return !data.keys().hasAny(['period'])
             ? (data.id == budgetId && data.categoryId == budgetId)
             : (data.period is string
                && data.period.matches('^[0-9]{4}(-(0[1-9]|1[0-2])y?)?$')
                && data.id == budgetId
                && budgetId == data.categoryId + '@' + data.period);
    }

    function validBudget(data, budgetId) {
      return data.keys().hasOnly([
               'id', 'scope', 'categoryId', 'amountAgorot', 'createdAt', 'updatedAt', 'businessId', 'period'
             ])
             && data.keys().hasAll([
               'id', 'scope', 'categoryId', 'amountAgorot', 'createdAt', 'updatedAt'
             ])
             && validBudgetPeriod(data, budgetId)
             && data.categoryId is string
             && data.scope in ['business', 'household']
             && data.amountAgorot is int
             && data.amountAgorot > 0
             && data.amountAgorot <= 100000000000
             && data.createdAt is int
             && data.updatedAt is int
             && validOptionalBusinessId(data);
    }

    // ---------- משימות ורשימת קניות ----------

    function validTask(data, taskId) {
      return data.keys().hasOnly([
               'id', 'scope', 'title', 'done', 'remind', 'remindDate', 'createdAt', 'updatedAt', 'businessId'
             ])
             && data.keys().hasAll([
               'id', 'scope', 'title', 'done', 'remind', 'remindDate', 'createdAt', 'updatedAt'
             ])
             && data.id == taskId
             && data.scope in ['business', 'household']
             && isNonEmptyString(data.title, 200)
             && data.done is bool
             && data.remind in ['none', 'every-open', 'daily', 'date']
             && data.remindDate is string
             && (data.remind == 'date'
                   ? data.remindDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
                   : data.remindDate == '')
             && data.createdAt is int
             && data.updatedAt is int
             && validOptionalBusinessId(data);
    }

    function validShoppingItem(data, itemId) {
      return data.keys().hasOnly([
               'id', 'scope', 'name', 'bought', 'createdAt', 'updatedAt', 'businessId'
             ])
             && data.keys().hasAll([
               'id', 'scope', 'name', 'bought', 'createdAt', 'updatedAt'
             ])
             && data.id == itemId
             && data.scope in ['business', 'household']
             && isNonEmptyString(data.name, 120)
             && data.bought is bool
             && data.createdAt is int
             && data.updatedAt is int
             && validOptionalBusinessId(data);
    }

    // ---------- פעולות כספיות (הכנסות והוצאות) ----------
    // זהה לעסק ולמשק בית. הסכום תמיד מספר שלם חיובי של אגורות.

    function validTransaction(data, transactionId) {
      return data.keys().hasOnly([
               'id', 'type', 'amountAgorot', 'date', 'yearMonth', 'year', 'month',
               'counterparty', 'categoryId', 'categoryName', 'paymentMethod',
               'note', 'titheStatus', 'isTithePayment', 'createdAt', 'updatedAt', 'businessId', 'currency', 'paymentLabel'
             ])
             && data.keys().hasAll([
               'id', 'type', 'amountAgorot', 'date', 'yearMonth', 'year', 'month',
               'counterparty', 'categoryId', 'categoryName', 'paymentMethod',
               'note', 'titheStatus', 'isTithePayment', 'createdAt', 'updatedAt'
             ])
             && data.id == transactionId
             && data.type in ['income', 'expense']
             && data.amountAgorot is int
             && data.amountAgorot > 0
             && data.amountAgorot <= 100000000000
             && data.date is string
             && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
             && data.yearMonth == data.date[0:7]
             && data.year is int
             && data.month is int
             && data.month >= 1
             && data.month <= 12
             && isShortString(data.counterparty, 120)
             && isNonEmptyString(data.categoryId, 100)
             && isShortString(data.categoryName, 60)
             && data.paymentMethod in ['cash', 'credit', 'direct', 'check', 'transfer', 'other']
             && ((data.paymentMethod == 'other') == data.keys().hasAny(['paymentLabel']))
             && (!data.keys().hasAny(['paymentLabel']) || isNonEmptyString(data.paymentLabel, 30))
             && isShortString(data.note, 1000)
             && data.titheStatus in ['liable', 'exempt']
             && data.isTithePayment is bool
             && (!data.keys().hasAny(['currency']) || data.currency in ['ILS', 'USD', 'EUR', 'GBP'])
             && data.createdAt is int
             && data.updatedAt is int
             && validOptionalBusinessId(data);
    }

    // ---------- הנתיבים ----------

    match /users/{uid} {
      allow read: if isWriter(uid);
      allow create: if isWriter(uid) && validUser(request.resource.data);
      allow update: if isWriter(uid)
                    && validUser(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isWriter(uid);

      match /settings/{settingsId} {
        allow read: if isReader(uid);
        allow create, update: if isWriter(uid)
                              && ((settingsId == 'main' && validSettings(request.resource.data))
                                  || (settingsId == 'paymentMethods' && validPaymentMethods(request.resource.data))
                                  || (settingsId == 'debtCategories' && validDebtCategories(request.resource.data))
                                  || (settingsId.matches('logo_.{1,64}') && validLogo(request.resource.data)));
        allow delete: if isWriter(uid);
      }

      match /businessProfile/{profileId} {
        allow read: if isReader(uid);
        allow create, update: if isWriter(uid)
                              && profileId == 'main'
                              && validProfileDoc(request.resource.data);
        allow delete: if isWriter(uid);
      }

      match /householdProfile/{profileId} {
        allow read: if isReader(uid);
        allow create, update: if isWriter(uid)
                              && profileId == 'main'
                              && validProfileDoc(request.resource.data);
        allow delete: if isWriter(uid);
      }

      match /businesses/{businessId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validBusiness(request.resource.data, businessId);
        allow update: if isWriter(uid)
                      && validBusiness(request.resource.data, businessId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        // עסקים לא נמחקים מהאפליקציה (רק מוסתרים במכשיר). המחיקה מותרת בעת מחיקת חשבון.
        allow delete: if isWriter(uid);
      }

      match /categories/{categoryId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validCategory(request.resource.data, categoryId);
        allow update: if isWriter(uid)
                      && validCategory(request.resource.data, categoryId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        // מחיקה מותרת לבעלים. פעולות קיימות שומרות את שם הקטגוריה בתוכן הפעולה,
        // ולכן ההיסטוריה והסיכומים לא נפגעים.
        allow delete: if isWriter(uid);
      }

      match /businessTransactions/{transactionId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validTransaction(request.resource.data, transactionId);
        allow update: if isWriter(uid)
                      && validTransaction(request.resource.data, transactionId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }

      match /householdTransactions/{transactionId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validTransaction(request.resource.data, transactionId);
        allow update: if isWriter(uid)
                      && validTransaction(request.resource.data, transactionId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }

      // תמונות מצורפות לפעולה (קבלה, תלוש): מסמך אחד לכל פעולה, עד שלוש תמונות.
      match /attachments/{transactionId} {
        allow read: if isReader(uid);
        allow create, update: if isWriter(uid)
                              && request.resource.data.keys().hasOnly(['images', 'updatedAt'])
                              && request.resource.data.keys().hasAll(['images', 'updatedAt'])
                              && request.resource.data.images is list
                              && request.resource.data.images.size() >= 1
                              && request.resource.data.images.size() <= 3
                              && request.resource.data.updatedAt is int;
        allow delete: if isWriter(uid);
      }

      match /debts/{debtId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validDebt(request.resource.data, debtId);
        allow update: if isWriter(uid)
                      && validDebt(request.resource.data, debtId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }

      match /budgets/{budgetId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validBudget(request.resource.data, budgetId);
        allow update: if isWriter(uid)
                      && validBudget(request.resource.data, budgetId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }

      match /tasks/{taskId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validTask(request.resource.data, taskId);
        allow update: if isWriter(uid)
                      && validTask(request.resource.data, taskId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }

      match /shoppingItems/{itemId} {
        allow read: if isReader(uid);
        allow create: if isWriter(uid) && validShoppingItem(request.resource.data, itemId);
        allow update: if isWriter(uid)
                      && validShoppingItem(request.resource.data, itemId)
                      && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isWriter(uid);
      }
    }

    // כל שאר הנתיבים חסומים.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
