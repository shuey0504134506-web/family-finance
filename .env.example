# העתק את הקובץ הזה לקובץ בשם .env והשלם את הערכים מ-Firebase Console:
# Project settings (גלגל שיניים) -> General -> Your apps -> Web app -> SDK setup and configuration
#
# אסור להעלות את קובץ .env ל-GitHub (הוא כבר ברשימת ההתעלמות של .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# אופציונלי: כתובת מייל ליצירת קשר בנושא פרטיות. תוצג במסך "מדיניות פרטיות".
VITE_PRIVACY_CONTACT_EMAIL=
